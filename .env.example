# Supabase (lokal: lihat output `npm run db:start`; produksi: Dashboard → Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server (buat/reset akun). JANGAN pernah expose ke client / commit.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (Fase 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Vercel cron keep-alive (Fase 6)
CRON_SECRET=
